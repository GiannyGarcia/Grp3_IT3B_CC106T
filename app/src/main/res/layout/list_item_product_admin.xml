<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/textInventoryProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000000"
            android:text="Product Label (Brand)" />

        <TextView
            android:id="@+id/textInventoryProductDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="Price: $19.99 | Exp: MM/DD/YYYY"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock: "
                android:textStyle="bold"
                android:textColor="#333333"/>

            <EditText
                android:id="@+id/editInventoryQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="New Quantity"
                android:padding="8dp"
                android:background="@drawable/rounded_edittext"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnUpdateQuantity"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Update"
                android:backgroundTint="#FFC107"
                android:textColor="#000000"
                android:paddingHorizontal="15dp"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>