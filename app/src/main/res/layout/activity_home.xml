<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp"
    tools:context=".HomeActivity">

    <!-- App Title -->
    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="San Isidro Pharmacy"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/teal_700"
        android:paddingBottom="8dp" />

    <!-- Welcome message -->
    <TextView
        android:id="@+id/homeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome! Browse our categories to start shopping."
        android:textSize="16sp"
        android:textColor="@color/black"
        android:paddingBottom="24dp" />

    <!-- Hero image or placeholder -->
    <ImageView
        android:id="@+id/homeImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:src="@drawable/pharmacy_banner"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_card_bg"
        android:contentDescription="Pharmacy Banner" />

    <!-- Bottom Navigation -->
    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>
