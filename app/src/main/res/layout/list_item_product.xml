<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/itemProductImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:contentDescription="Product Image"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/itemProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name (Label)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/itemProductCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: Prescription Medicines"
            android:textSize="12sp"
            android:textColor="#007BFF"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/itemProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$99.99"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#28A745"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/itemProductDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Detailed description of the product goes here..."
            android:textColor="#666666"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/itemButtonAddToCart"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="View Details / Add to Cart"
            android:backgroundTint="#FFC107"
            android:textColor="#333333"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>