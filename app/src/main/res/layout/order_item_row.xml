<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="10dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView android:id="@+id/txtItemName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Product name" android:textStyle="bold"/>
    <TextView android:id="@+id/txtItemQty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qty"/>
    <TextView android:id="@+id/txtItemPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Price"/>
</LinearLayout>
