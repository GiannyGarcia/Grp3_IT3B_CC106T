<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".CartActivity">

    <!-- Main content wrapped in NestedScrollView in case content grows -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"> <!-- margin to avoid bottom nav overlap -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/cartTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="My Cart"
                android:textColor="@color/Green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cartMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="20dp"
                android:text="Your cart is currently empty."
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/cartImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="Empty cart illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/empty_cart" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation fixed at the bottom -->
    <include
        android:id="@+id/include_bottom_nav"
        layout="@layout/include_bottom_nav"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
