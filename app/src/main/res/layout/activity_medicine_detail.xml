<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:background="@android:color/white"
            android:padding="6dp"
            android:elevation="4dp"
            android:src="@drawable/pharmacy_logo" />

        <!-- Medicine Name -->
        <TextView
            android:id="@+id/detailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicine Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#B71C1C"
            android:layout_marginTop="16dp" />

        <!-- Price -->
        <TextView
            android:id="@+id/detailPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textSize="18sp"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Category -->
        <TextView
            android:id="@+id/detailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: OTC"
            android:textSize="16sp"
            android:textColor="#333"
            android:layout_marginTop="10dp" />

        <!-- Prescription Indicator -->
        <TextView
            android:id="@+id/detailPrescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OTC"
            android:textSize="16sp"
            android:textColor="#333"
            android:layout_marginTop="4dp" />

        <!-- Stock -->
        <TextView
            android:id="@+id/detailStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock: 0"
            android:textSize="16sp"
            android:textColor="#555"
            android:layout_marginTop="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description goes here..."
            android:textSize="16sp"
            android:textColor="#333"
            android:layout_marginBottom="12dp" />

        <!-- Dosage -->
        <TextView
            android:id="@+id/detailDosage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dosage: N/A"
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#555" />

    </LinearLayout>

</ScrollView>
