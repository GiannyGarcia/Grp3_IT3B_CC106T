<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/bottom_nav"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:scaleType="centerCrop"
                android:background="@android:color/white"
                android:padding="6dp"
                android:src="@drawable/pharmacy_logo" />

            <TextView
                android:id="@+id/detailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Name"
                android:textSize="22sp"
                android:textColor="#B71C1C"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/detailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="18sp"
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/detailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category: OTC"
                android:textSize="16sp"
                android:textColor="#333"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/detailPrescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OTC"
                android:textSize="16sp"
                android:textColor="#333"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/detailStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock: 0"
                android:textSize="16sp"
                android:textColor="#555"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description goes here..."
                android:textSize="16sp"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/detailDosage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dosage: N/A"
                android:textSize="16sp"
                android:textStyle="italic"
                android:textColor="#555" />

            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#DD0000"
                android:padding="12dp"
                android:text="Add to Cart"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_nav"
        layout="@layout/include_bottom_nav" />

</RelativeLayout>
